# ─────────────────────────────────────────────────────────────
# AI Purchasing Agent — environment configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ---- LLM provider ------------------------------------------------
# One of: gemini | anthropic | openai | deterministic
# `deterministic` runs the whole agent with a rule-based planner and
# NO network calls — useful for offline demos and reproducible evals.
LLM_PROVIDER=gemini

# Model id for the chosen provider.
#   gemini     -> gemini-2.5-flash / gemini-2.5-pro
#   anthropic  -> claude-sonnet-5 / claude-opus-5
#   openai     -> gpt-4.1 / gpt-4o
LLM_MODEL=gemini-2.5-flash

# Only the key for your chosen provider is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Sampling + safety rails for the reasoning loop.
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- database ----------------------------------------------------
# docker compose supplies Postgres. For a bare local run you can use:
#   DATABASE_URL=sqlite+pysqlite:///./data/agent.db
DATABASE_URL=postgresql+psycopg://buyer:buyer@postgres:5432/buyer_agent

# ---- agent behaviour ---------------------------------------------
# Hard stop on the reason -> act -> validate -> replan loop.
AGENT_MAX_REPLAN_ATTEMPTS=3
# Max read-tool calls the agent may make while investigating a case.
AGENT_MAX_INVESTIGATION_STEPS=14

# Autonomy policy: orders at or below this landed value may be executed
# without a human, provided validation is clean. Above it -> approval queue.
AUTONOMY_AUTO_APPROVE_MAX_VALUE_USD=5000
# If the agent's quantity deviates from the system recommendation by more
# than this fraction, a human approves regardless of order value.
AUTONOMY_MAX_DEVIATION_WITHOUT_APPROVAL=0.35

# ---- supplier simulator -----------------------------------------
# Deterministic seed so partial-fulfilment / rejection outcomes are
# reproducible across eval runs.
SUPPLIER_SIM_SEED=42

# ---- app ---------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
